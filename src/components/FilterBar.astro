---
import { CATEGORIES, HEAT_PROFILES } from '../content.config';

const MARINATE_OPTIONS = [
  { value: 'required', label: '需腌制' },
  { value: 'none', label: '免腌' },
] as const;
---

<noscript>
  <style>
    .filter-bar {
      display: none;
    }
  </style>
</noscript>

<div class="filter-bar" id="filter-bar">
  <div class="search-row">
    <div class="search-box">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="search-icon">
        <circle cx="10.5" cy="10.5" r="6.5" />
        <path d="m20 20-4.35-4.35" />
      </svg>
      <input type="text" id="search-input" placeholder="搜索食材名或摘要…" autocomplete="off" />
    </div>
    <span class="result-count"><span id="result-count">0</span> 种</span>
  </div>

  <div class="filter-row" data-filter="cat">
    <span class="filter-label">分类</span>
    <div class="chips">
      <button class="chip active" data-value="all" type="button">全部</button>
      {CATEGORIES.map((c) => (
        <button class="chip" data-value={c} type="button">
          {c}
        </button>
      ))}
    </div>
  </div>

  <div class="filter-row" data-filter="marinate">
    <span class="filter-label">腌制</span>
    <div class="chips">
      <button class="chip active" data-value="all" type="button">不限</button>
      {MARINATE_OPTIONS.map((o) => (
        <button class="chip" data-value={o.value} type="button">
          {o.label}
        </button>
      ))}
    </div>
  </div>

  <div class="filter-row" data-filter="heat">
    <span class="filter-label">火候</span>
    <div class="chips">
      <button class="chip active" data-value="all" type="button">不限</button>
      {HEAT_PROFILES.map((h) => (
        <button class="chip" data-value={h} type="button">
          {h}
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  const filterBar = document.getElementById('filter-bar');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const resultCount = document.getElementById('result-count');
  const emptyState = document.getElementById('filter-empty') as HTMLElement | null;

  if (filterBar && searchInput && resultCount) {
    const getActiveChipValue = (name: string): string => {
      const row = filterBar.querySelector(`[data-filter="${name}"]`);
      return row?.querySelector('.chip.active')?.getAttribute('data-value') || 'all';
    };

    const setActiveChip = (name: string, value: string) => {
      const row = filterBar.querySelector(`[data-filter="${name}"]`);
      if (!row) return;
      const chips = Array.from(row.querySelectorAll<HTMLButtonElement>('.chip'));
      const matched = chips.some((c) => c.dataset.value === value);
      chips.forEach((c) => c.classList.toggle('active', c.dataset.value === (matched ? value : 'all')));
    };

    const syncUrl = (state: { cat: string; marinate: string; heat: string; q: string }) => {
      const params = new URLSearchParams();
      if (state.cat !== 'all') params.set('cat', state.cat);
      if (state.marinate !== 'all') params.set('marinate', state.marinate);
      if (state.heat !== 'all') params.set('heat', state.heat);
      if (state.q) params.set('q', state.q);
      const qs = params.toString();
      history.replaceState(null, '', location.pathname + (qs ? `?${qs}` : ''));
    };

    const applyFilters = () => {
      const state = {
        cat: getActiveChipValue('cat'),
        marinate: getActiveChipValue('marinate'),
        heat: getActiveChipValue('heat'),
        q: searchInput.value.trim(),
      };
      const q = state.q.toLowerCase();
      const cards = document.querySelectorAll<HTMLElement>('#card-grid .card');
      let visible = 0;
      cards.forEach((card) => {
        const matchCat = state.cat === 'all' || card.dataset.cat === state.cat;
        const matchMarinate = state.marinate === 'all' || card.dataset.marinate === state.marinate;
        const matchHeat = state.heat === 'all' || card.dataset.heat === state.heat;
        const matchQ = !q || (card.dataset.name || '').toLowerCase().includes(q) || (card.dataset.summary || '').toLowerCase().includes(q);
        const show = matchCat && matchMarinate && matchHeat && matchQ;
        card.hidden = !show;
        if (show) visible += 1;
      });
      resultCount.textContent = String(visible);
      if (emptyState) emptyState.hidden = visible !== 0;
      syncUrl(state);
    };

    filterBar.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest('.chip') as HTMLButtonElement | null;
      if (!chip) return;
      const row = chip.closest('.filter-row');
      row?.querySelectorAll('.chip').forEach((c) => c.classList.remove('active'));
      chip.classList.add('active');
      applyFilters();
    });

    searchInput.addEventListener('input', applyFilters);

    // 首屏反向读 URL 恢复状态
    const params = new URLSearchParams(location.search);
    setActiveChip('cat', params.get('cat') || 'all');
    setActiveChip('marinate', params.get('marinate') || 'all');
    setActiveChip('heat', params.get('heat') || 'all');
    searchInput.value = params.get('q') || '';

    applyFilters();
  }
</script>

<style>
  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 28px;
  }
  .search-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .search-box {
    position: relative;
    max-width: 360px;
    flex: 1;
    min-width: 200px;
  }
  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-3);
    pointer-events: none;
  }
  .search-box input {
    width: 100%;
    padding: 9px 14px 9px 36px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-family: var(--font);
    font-size: 14px;
    color: var(--text);
    outline: none;
    transition: border-color 0.2s;
  }
  .search-box input:focus {
    border-color: var(--accent);
  }
  .search-box input::placeholder {
    color: var(--text-3);
  }
  .result-count {
    font-size: 13px;
    color: var(--text-3);
    white-space: nowrap;
  }
  #result-count {
    color: var(--text);
    font-weight: 700;
  }

  .filter-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .filter-label {
    font-size: 12px;
    color: var(--text-3);
    flex-shrink: 0;
    width: 32px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    padding: 5px 12px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-2);
    font-family: var(--font);
    font-size: 12px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .chip:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .chip.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
</style>
