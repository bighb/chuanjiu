---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photo?: ImageMetadata;
  alt?: string;
  hint?: string;
  ratio?: '16/9' | '4/3' | '21/9';
  label?: string;
}
const { photo, alt, hint, ratio = '16/9', label } = Astro.props;
---

{
  photo ? (
    <div class="photo-slot has-photo" style={`aspect-ratio: ${ratio}`}>
      <Image src={photo} alt={alt ?? ''} loading="lazy" decoding="async" />
    </div>
  ) : (
    <div class="photo-slot placeholder" style={`aspect-ratio: ${ratio}`}>
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="camera-icon">
        <path d="M4 8h3l1.5-2h7L17 8h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z" />
        <circle cx="12" cy="13.5" r="3.5" />
      </svg>
      {label && <span class="slot-label">{label}</span>}
      {hint && <span class="slot-hint">{hint}</span>}
    </div>
  )
}

<style>
  .photo-slot {
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
  }
  .photo-slot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .placeholder {
    border: 2px dashed var(--slot-border);
    background: var(--slot-bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 16px;
    text-align: center;
  }
  .camera-icon {
    color: var(--accent);
  }
  .slot-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-2);
  }
  .slot-hint {
    font-size: 12px;
    color: var(--text-3);
  }
</style>
